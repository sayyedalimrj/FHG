<Window x:Class="FHG.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FHG Secure Browser" Width="940" Height="720"
        MinWidth="780" MinHeight="630"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020" Foreground="#EFF6FF"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#151E32"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#293650"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#95A6C4"/>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#3C91EA"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="20,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="chrome" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="chrome" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#27344D"/>
      <Setter Property="Foreground" Value="#E8F0FA"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Background" Value="#493043"/>
      <Setter Property="Foreground" Value="#FFD8DE"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="ValueLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDF5FF"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="34,26,34,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="22"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="54" Height="54" CornerRadius="15" Background="#174F71" Margin="0,0,16,0">
          <Grid><TextBlock Text="◆" FontSize="26" Foreground="#52E5C4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="FHG Browser" FontSize="27" FontWeight="Bold"/>
          <TextBlock Text="Firefox + Hiddify  ·  private by design" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" CornerRadius="17" Padding="13,8" BorderBrush="#39617B" BorderThickness="1" Background="#152E43" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="StateDot" Text="●" Foreground="#E9AE60" Margin="0,0,9,0"/>
          <TextBlock x:Name="ConnectionBadge" Text="Offline" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Grid.Column="0" x:Name="AddTab" Content="Import" Style="{StaticResource PrimaryButton}" Padding="10,9" Tag="add" Click="Tab_Click"/>
          <Button Grid.Column="2" x:Name="SubsTab" Content="Subscriptions" Style="{StaticResource SecondaryButton}" Padding="10,9" Tag="subs" Click="Tab_Click"/>
          <Button Grid.Column="4" x:Name="NodesTab" Content="Servers" Style="{StaticResource SecondaryButton}" Padding="10,9" Tag="nodes" Click="Tab_Click"/>
        </Grid>
        <Grid Grid.Row="2">
          <Border x:Name="AddPanel" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="17"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Connection profile" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="Paste a Hiddify share link, subscription URL, JSON or config text." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="PROFILE INPUT" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
          <Border Grid.Row="4" CornerRadius="12" BorderBrush="#3C4D69" BorderThickness="1" Background="#0C1528">
            <TextBox x:Name="ConfigInput" AcceptsReturn="True" AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     TextWrapping="Wrap" Foreground="#EAF5FF" CaretBrush="#56DABF" FontFamily="Consolas"
                     FontSize="12" Background="Transparent" BorderThickness="0" Padding="14"
                     SpellCheck.IsEnabled="False"
                     ToolTip="Paste subscription URL, share link, or full configuration here"/>
          </Border>
          <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Paste" Style="{StaticResource SecondaryButton}" Click="Paste_Click"/>
            <Button Grid.Column="2" Content="Import file" Style="{StaticResource SecondaryButton}" Click="Import_Click"/>
            <Button Grid.Column="4" Content="Clear" Style="{StaticResource SecondaryButton}" Click="Clear_Click"/>
          </Grid>
          <TextBlock Grid.Row="8" x:Name="ConfigHint" Foreground="#91AACA" TextWrapping="Wrap" FontSize="12"
                     Text="No profile applied yet. Paste or import one to connect."/>
          <Grid Grid.Row="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ConnectButton" Content="Connect" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
            <Button Grid.Column="2" x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource DangerButton}" Click="Disconnect_Click"/>
          </Grid>
        </Grid>
      </Border>


          <Border x:Name="SubscriptionsPanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="15"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0">
                <TextBlock Text="My subscriptions" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Choose a profile and review your traffic balance." Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
              <ListBox Grid.Row="2" x:Name="SubscriptionList" SelectionChanged="SubscriptionList_SelectionChanged"
                       Background="#0C1528" Foreground="#EFF6FF" BorderBrush="#3C4D69" BorderThickness="1" FontSize="14">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,7,8,7"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Usage}" FontSize="11" Foreground="#9DB2D1" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Row="4" Background="#0C1528" CornerRadius="11" Padding="14">
                <StackPanel>
                  <TextBlock x:Name="SelectedSubName" Text="Select a subscription" FontWeight="SemiBold" FontSize="16"/>
                  <TextBlock Text="TRAFFIC USED" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                  <TextBlock x:Name="SubUsage" Text="—" FontSize="15"/>
                  <ProgressBar x:Name="SubProgress" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,3" Foreground="#52E5C4"/>
                  <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="REMAINING" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SubRemaining" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="EXPIRY" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SubExpiry" Text="—" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Activate" Style="{StaticResource PrimaryButton}" Padding="9,10" Click="ActivateSub_Click"/>
                <Button Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButton}" Padding="9,10" Click="RefreshSub_Click"/>
                <Button Grid.Column="4" Content="Remove" Style="{StaticResource DangerButton}" Padding="9,10" Click="RemoveSub_Click"/>
              </Grid>
            </Grid>
          </Border>

          <Border x:Name="ServersPanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Subscription servers" FontSize="20" FontWeight="Bold"/>
              <TextBlock Grid.Row="2" x:Name="ServersHint" Text="Connect a subscription to load nodes from Hiddify Core." Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
              <ListBox Grid.Row="4" x:Name="ServerList" Background="#0C1528" Foreground="#EFF6FF"
                       BorderBrush="#3C4D69" BorderThickness="1">
                <ListBox.ItemTemplate>
                  <DataTemplate><Grid Margin="8,8,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Type}" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Latency}" Foreground="#4ADEB5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </Grid></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Reload" Style="{StaticResource SecondaryButton}" Padding="8,10" Click="ReloadNodes_Click"/>
                <Button Grid.Column="2" Content="Test ping" Style="{StaticResource SecondaryButton}" Padding="8,10" Click="TestNode_Click"/>
                <Button Grid.Column="4" Content="Select" Style="{StaticResource PrimaryButton}" Padding="8,10" Click="SelectNode_Click"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Live connection" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="Only through local Hiddify SOCKS5" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,16"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="PROXY" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="ProxyStatus" Text="Unavailable" Style="{StaticResource ValueLabel}" FontSize="15"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="HTTPS LATENCY" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="LatencyStatus" Text="—" Style="{StaticResource ValueLabel}" FontSize="16"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="127.0.0.1:12334 · SOCKS5" Foreground="#86A1C8" FontFamily="Consolas" FontSize="11" Margin="0,16,0,12"/>
            <Button Content="Test via Hiddify" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButton}" Click="Ping_Click"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Browser protection" FontSize="19" FontWeight="Bold"/>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Network guard" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock Grid.Column="1" x:Name="GuardStatus" Text="Checking" FontWeight="SemiBold" Foreground="#F6C782"/>
            </Grid>
            <Grid Grid.Row="4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Hiddify Core" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock Grid.Column="1" x:Name="CoreStatus" Text="Stopped" FontWeight="SemiBold" Foreground="#F6C782"/>
            </Grid>
            <TextBlock Grid.Row="6" Text="If Hiddify disconnects, browser tabs stay open. Direct network fallback is never intentional." FontSize="12" Foreground="#A2B9D6" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="8">
              <Button x:Name="BrowserButton" Content="Open secure browser" FontSize="15" Style="{StaticResource PrimaryButton}" Padding="15,14" Click="OpenBrowser_Click"/>
              <Button Content="Configure guard" Style="{StaticResource SecondaryButton}" Margin="0,9,0,0" Click="Guard_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="4" Background="#101A2C" BorderBrush="#23334F" BorderThickness="1" CornerRadius="11" Padding="15,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="MessageStatus" Text="Ready. Your regular Firefox remains untouched." TextWrapping="Wrap" Foreground="#A6BEDD" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="FHG  •  ALPHA" Foreground="#6F839E" FontSize="11" Margin="15,0,0,0" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>

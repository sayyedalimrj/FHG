      {
        "Title": "ChatGPT",
        "URL": "https://chatgpt.com/",
        "Placement": "toolbar"
      }
    ],
    "Extensions": {
      "Install": [
        "https://addons.mozilla.org/firefox/downloads/latest/totp/latest.xpi"
      ]
    }
  }
}

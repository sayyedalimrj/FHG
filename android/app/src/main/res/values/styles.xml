<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform-native dark Material theme; no heavyweight UI dependencies. -->
    <style name="FhgSecureTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#55E1C8</item>
        <item name="android:windowBackground">#0B1020</item>
        <item name="android:statusBarColor">#0B1020</item>
        <item name="android:navigationBarColor">#0B1020</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
